# Porta do servidor (Railway define automaticamente via $PORT)
PORT=3000

# Ambiente
NODE_ENV=production

# JWT Secret — troque por uma string longa e aleatória
JWT_SECRET=troque-isso-por-uma-string-secreta-longa

# URL do frontend Vercel (para CORS)
FRONTEND_URL=https://seu-dominio.vercel.app

# Caminho do banco de dados
# Local:      deixe em branco (usa ./data/db.json por padrão)
# Railway:    /app/data/db.json
DB_PATH=/app/data/db.json

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_senha_de_app_aqui
SMTP_FROM=MatchED <seu@gmail.com>

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
