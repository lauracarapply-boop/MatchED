# ── MatchED backend configuration ──
# Copy to .env (npm run setup does this for you) and fill in.

# Server port (Railway sets this automatically)
PORT=3000

# development | production
NODE_ENV=production

# REQUIRED in production: long random string (64+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Who can open the admin panel (comma-separated). Must also have an account.
ADMIN_EMAILS=lauracar.apply@gmail.com

# Public address of the website (used in e-mails and redirects)
FRONTEND_URL=https://your-site.netlify.app
# Public address of this API, if different from the website (Google login callback)
API_URL=
# Extra origins allowed to call the API (comma-separated)
CORS_ORIGINS=

# Database file. Local: leave empty (uses ./data/db.json). Railway: /app/data/db.json
DB_PATH=/app/data/db.json

# E-mail (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MatchED <your@gmail.com>

# Deadline reminder e-mails (needs SMTP). Set to false to turn off.
REMINDERS_ENABLED=true

# Skip e-mail confirmation on sign-up (only for testing)
SKIP_EMAIL_VERIFICATION=false

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI extraction for the capture bot (optional)
ANTHROPIC_API_KEY=
